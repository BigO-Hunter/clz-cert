import Mathlib

/-!
# CLZ certified kernel machinery (generic layer)

k(x) := K(x)/K(0), K(x) = ½[sinc(πx−1/√2) + sinc(πx+1/√2)] (Mathlib `Real.sinc`,
= sin t / t, removable at 0; K(0) = sinc(1/√2) since sinc is even).
This is *literally* the Montgomery–Taylor kernel of ainta/zeta-simple-zeros.

Status: enclosures PROVED; kernel equalities PROVED; CLZ_GAP_SINPOS and
CLZ_GAP_TAIL are PROVED (see GAPS_REPORT.md); the sin/cos partial-sum
enclosure lemmas feed both the H0 tan-sandwich and the per-box receipts
(generated by gen_cert.py) which instantiate the consumer with frozen ℚ
literals.
-/

namespace CLZ

open Real
open scoped Nat

/-! ## Certified enclosures (PROVED) -/

theorem pi_lb : (3.14159265358979323846 : ℝ) < π := pi_gt_d20
theorem pi_ub : π < (3.14159265358979323847 : ℝ) := pi_lt_d20

theorem sqrt2_lb : (1.4142135623730950488 : ℝ) < sqrt 2 := by
  have h : (1.4142135623730950488 : ℝ)^2 < 2 := by norm_num
  rw [← sqrt_sq (show (0:ℝ) ≤ 1.4142135623730950488 by norm_num)]
  exact sqrt_lt_sqrt (by nlinarith) h

theorem sqrt2_ub : sqrt 2 < (1.4142135623730950489 : ℝ) := by
  have h : 2 < (1.4142135623730950489 : ℝ)^2 := by norm_num
  rw [← sqrt_sq (show (0:ℝ) ≤ 1.4142135623730950489 by norm_num)]
  exact sqrt_lt_sqrt (by norm_num) h

/-- a = 1/√2 -/
noncomputable def a : ℝ := 1 / sqrt 2

theorem a_lb : (0.7071067811865475244 : ℝ) ≤ a := by
  have h : sqrt 2 ≤ 1 / (0.7071067811865475244 : ℝ) := by
    rw [sqrt_le_left (by positivity)]
    norm_num
  have h2 := (inv_le_inv₀ (by norm_num : (0:ℝ) < 1 / 0.7071067811865475244)
      (by nlinarith [sqrt2_lb, sqrt2_lb])).mpr h
  show (0.7071067811865475244:ℝ) ≤ 1/sqrt 2
  simpa using h2

theorem a_ub : a ≤ (0.7071067811865475245 : ℝ) := by
  rw [a, div_le_iff₀ (by nlinarith [sqrt2_lb, sqrt2_lb])]
  nlinarith [sqrt2_lb]

theorem a_ne : a ≠ 0 := by
  rw [a]; simp

/-! ## The kernel (PROVED equalities) -/

/-- K(x) = ½[sinc(πx−a) + sinc(πx+a)] — the Montgomery–Taylor kernel. -/
noncomputable def Kfn (x : ℝ) : ℝ := (sinc (π*x - a) + sinc (π*x + a)) / 2

/-- K(0) = sinc(a) (sinc is even). -/
theorem Kfn_zero : Kfn 0 = sinc a := by
  unfold Kfn
  simp only [mul_zero, zero_add, zero_sub]
  have hane : (-a) ≠ 0 := by rw [a]; simp
  have heven : sinc (-a) = sinc a := by
    rw [sinc, sinc, if_neg hane, if_neg a_ne, Real.sin_neg]
    ring
  rw [heven]
  ring

/-- The normalized kernel k(x) = K(x)/K(0). -/
noncomputable def kk (x : ℝ) : ℝ := Kfn x / Kfn 0

theorem a_sin_ne : sin a ≠ 0 := by
  -- CLZ_GAP_SINPOS (PROVED): 0 < a < π ⟹ sin a > 0.
  have h0 : (0:ℝ) < a := by
    rw [a]; exact div_pos (by norm_num) (sqrt_pos.2 (by norm_num))
  have h1 : a < π := by
    have h12 : (1:ℝ) < sqrt 2 := (lt_sqrt (by norm_num)).2 (by norm_num)
    have hlt1 : a < 1 := by
      rw [a]
      exact (div_lt_one (show (0:ℝ) < sqrt 2 by norm_num)).2 h12
    exact lt_of_lt_of_le hlt1 (by linarith [pi_lb])
  exact ne_of_gt (sin_pos_of_pos_of_lt_pi h0 h1)

theorem Kfn_zero_ne : Kfn 0 ≠ 0 := by
  rw [Kfn_zero, sinc, if_neg a_ne]
  exact div_ne_zero a_sin_ne (by rw [a]; simp)

/-! ## Alternating-series tail (PROVED) -/

private theorem neg_one_pow_two_mul (j : ℕ) : (-1 : ℝ)^(2*j) = 1 := by
  induction j with
  | zero => norm_num
  | succ n ih =>
    rw [show (2*(n+1):ℕ) = (2*n)+2 by ring, pow_add, ih, pow_two]
    norm_num

private theorem neg_one_pow_odd_two_mul (j : ℕ) : (-1 : ℝ)^(2*j+1) = -1 := by
  rw [pow_succ, neg_one_pow_two_mul j, one_mul]

/-- Reduced alternating bound: partial sums of `∑ (-1)^k c k` stay in `[0, c 0]`
(even length) and `[0, c 0]` (odd length) whenever `c` is antitone and
nonnegative — the two-invariant induction (even sums `E_j`, odd sums `O_j`):
`0 ≤ E_j ≤ O_j ≤ c 0` propagates since `E_{j+1} = O_j − c(2j+1) ≥ 0`,
`O_{j+1} = O_j − c(2j+1) + c(2j+2) ≤ O_j`. -/
theorem alt_partial_bound (c : ℕ → ℝ) (hdec : ∀ k, c (k+1) ≤ c k) (hpos : ∀ k, 0 ≤ c k) :
    ∀ m, |∑ k ∈ Finset.range m, (-1:ℝ)^k * c k| ≤ c 0 := by
  have key : ∀ j : ℕ,
      0 ≤ ∑ k ∈ Finset.range (2*j), (-1:ℝ)^k * c k ∧
      ∑ k ∈ Finset.range (2*j), (-1:ℝ)^k * c k
        ≤ ∑ k ∈ Finset.range (2*j+1), (-1:ℝ)^k * c k ∧
      ∑ k ∈ Finset.range (2*j+1), (-1:ℝ)^k * c k ≤ c 0 := by
    intro j
    induction j with
    | zero => simp [hpos 0]
    | succ n ih =>
      obtain ⟨h0, h1, h2⟩ := ih
      have hOE : ∑ k ∈ Finset.range (2*n+1), (-1:ℝ)^k * c k
          = ∑ k ∈ Finset.range (2*n), (-1:ℝ)^k * c k + c (2*n) := by
        rw [show (2*n+1 : ℕ) = (2*n)+1 by ring, Finset.sum_range_succ,
          neg_one_pow_two_mul n, one_mul]
      have hE' : ∑ k ∈ Finset.range (2*(n+1)), (-1:ℝ)^k * c k
          = ∑ k ∈ Finset.range (2*n+1), (-1:ℝ)^k * c k - c (2*n+1) := by
        rw [show (2*(n+1):ℕ) = (2*n+1)+1 by ring, Finset.sum_range_succ,
          neg_one_pow_odd_two_mul n, neg_one_mul]
        ring
      have hO' : ∑ k ∈ Finset.range (2*(n+1)+1), (-1:ℝ)^k * c k
          = ∑ k ∈ Finset.range (2*(n+1)), (-1:ℝ)^k * c k + c (2*(n+1)) := by
        rw [show (2*(n+1)+1:ℕ) = (2*(n+1))+1 by ring, Finset.sum_range_succ,
          neg_one_pow_two_mul (n+1), one_mul]
      have hstep : c (2*(n+1)) ≤ c (2*n+1) := by
        rw [show (2*(n+1):ℕ) = 2*n+1+1 by ring]; exact hdec (2*n+1)
      refine ⟨?_, ?_, ?_⟩
      · rw [hE', hOE]; linarith [hdec (2*n), hpos (2*n)]
      · rw [hO']; linarith [hpos (2*(n+1))]
      · rw [hO', hE', hOE]; linarith [hstep, h2]
  intro m
  rcases Nat.even_or_odd m with ⟨j, hj⟩ | ⟨j, hj⟩
  · obtain ⟨e0, e1, e2⟩ := key j
    rw [hj, show j + j = 2*j from by ring, abs_eq_self.2 e0]
    exact le_trans e1 e2
  · obtain ⟨e0, e1, e2⟩ := key j
    rw [hj, abs_le]
    exact ⟨by linarith, e2⟩

private theorem sum_sign_shift (b : ℕ → ℝ) (N M : ℕ) :
    (∑ i ∈ Finset.range M, (-1:ℝ)^(N+i) * b (N+i))
      = (-1:ℝ)^N * (∑ i ∈ Finset.range M, (-1:ℝ)^i * b (N+i)) := by
  induction M with
  | zero => simp
  | succ m ih =>
    rw [Finset.sum_range_succ, Finset.sum_range_succ, ih, pow_add]
    ring

/-- If `b` is nonincreasing from `N` on and nonnegative, every partial sum past
`N` stays within `b N` of the `N`-th partial sum (first-omitted-term estimate,
partial-sum form). -/
theorem alternating_tail_range (b : ℕ → ℝ) (N n : ℕ) (hdec : ∀ k, N ≤ k → b (k+1) ≤ b k)
    (hpos : ∀ k, 0 ≤ b k) (hn : N ≤ n) :
    |(∑ k ∈ Finset.range n, (-1 : ℝ)^k * b k) - (∑ k ∈ Finset.range N, (-1 : ℝ)^k * b k)|
      ≤ b N := by
  have hsplit : (∑ k ∈ Finset.range n, (-1 : ℝ)^k * b k)
      = (∑ k ∈ Finset.range N, (-1 : ℝ)^k * b k)
        + (-1:ℝ)^N * (∑ i ∈ Finset.range (n - N), (-1 : ℝ)^i * b (N + i)) := by
    rw [← Finset.sum_range_add_sum_Ico _ hn, Finset.sum_Ico_eq_sum_range, sum_sign_shift]
  have hc : ∀ k, b (N + (k+1)) ≤ b (N + k) := fun k => hdec _ (Nat.le_add_right N k)
  have hred := alt_partial_bound (fun k => b (N + k)) hc (fun k => hpos _) (n - N)
  simp only [Nat.add_zero] at hred
  rw [hsplit, add_sub_cancel_left, abs_mul]
  rcases Nat.even_or_odd N with ⟨j, hj⟩ | ⟨j, hj⟩
  · subst hj
    have h2j : j + j = 2*j := by ring
    rw [h2j] at hred ⊢
    rw [neg_one_pow_two_mul j, abs_one, one_mul]; exact hred
  · subst hj
    rw [neg_one_pow_odd_two_mul j, abs_neg, abs_one, one_mul]; exact hred

/-- If `b` is nonincreasing from `N` on and nonnegative and the alternating
series is summable, its sum is within `b N` (the first omitted term) of the
`N`-th partial sum. CLZ_GAP_TAIL (PROVED; restated from the original named
statement by adding the necessary `Summable` hypothesis — without it `tsum`
need not exist and the original claim is false, e.g. `b k = 1 + 1/(k+1)`). -/
theorem alternating_tail (b : ℕ → ℝ) (N : ℕ) (hdec : ∀ k, N ≤ k → b (k+1) ≤ b k)
    (hpos : ∀ k, 0 ≤ b k) (hsumm : Summable (fun k => (-1 : ℝ)^k * b k)) :
    |(∑' k, (-1 : ℝ)^k * b k) - (∑ k ∈ Finset.range N, (-1 : ℝ)^k * b k)| ≤ b N := by
  have htends : Filter.Tendsto (fun m => ∑ k ∈ Finset.range m, (-1 : ℝ)^k * b k) Filter.atTop
      (nhds (∑' k, (-1 : ℝ)^k * b k)) := hsumm.hasSum.tendsto_sum_nat
  refine le_of_forall_pos_le_add fun ε hε => ?_
  obtain ⟨m0, hm0⟩ := Metric.tendsto_atTop.mp htends (ε/2) (by linarith)
  obtain ⟨m, hm1, hm2⟩ : ∃ m, m0 ≤ m ∧ N ≤ m := ⟨max m0 N, le_max_left _ _, le_max_right _ _⟩
  have hd1 : |(∑' k, (-1 : ℝ)^k * b k) - (∑ k ∈ Finset.range m, (-1 : ℝ)^k * b k)| < ε := by
    have h := hm0 m hm1
    rw [Real.dist_eq, abs_sub_comm] at h
    linarith
  have hd2 := alternating_tail_range b N m hdec hpos hm2
  calc |(∑' k, (-1 : ℝ)^k * b k) - (∑ k ∈ Finset.range N, (-1 : ℝ)^k * b k)|
      = |((∑' k, (-1 : ℝ)^k * b k) - (∑ k ∈ Finset.range m, (-1 : ℝ)^k * b k))
          + ((∑ k ∈ Finset.range m, (-1 : ℝ)^k * b k)
              - (∑ k ∈ Finset.range N, (-1 : ℝ)^k * b k))| := by ring_nf
    _ ≤ |(∑' k, (-1 : ℝ)^k * b k) - (∑ k ∈ Finset.range m, (-1 : ℝ)^k * b k)|
          + |(∑ k ∈ Finset.range m, (-1 : ℝ)^k * b k)
              - (∑ k ∈ Finset.range N, (-1 : ℝ)^k * b k)| := abs_add_le _ _
    _ ≤ b N + ε := by linarith

/-! ## Partial-sum enclosures for sin and cos (PROVED) -/

/-- `sin x` is within `x^(2n+3)/(2n+3)!` of the range-`(n+1)` alternating
partial sum of its power series (terms decrease once `x^2 ≤ 6`). -/
theorem sin_partial_abs_bound (x : ℝ) (hx : 0 ≤ x) (n : ℕ)
    (hmono : ∀ k : ℕ, x^2 ≤ (2*k+2)*(2*k+3)) :
    |sin x - (∑ k ∈ Finset.range (n+1), (-1:ℝ)^k * x^(2*k+1)/((2*k+1)! : ℝ))|
      ≤ x^(2*n+3)/((2*n+3)! : ℝ) := by
  have hdec : ∀ k, x^(2*(k+1)+1)/((2*(k+1)+1)! : ℝ) ≤ x^(2*k+1)/((2*k+1)! : ℝ) := by
    intro k
    have hk : (2*(k+1)+1 : ℕ) = 2*k+3 := by ring
    rw [hk]
    have hfact : ((2*k+3)! : ℝ) = ((2*k+3) * (2*k+2) * (2*k+1)! : ℝ) := by
      rw [show ((2*k+3)! : ℕ) = (2*k+3) * (2*k+2) * (2*k+1)! by
        rw [show (2*k+3:ℕ) = (2*k+2)+1 by ring, Nat.factorial_succ,
            show (2*k+2:ℕ) = (2*k+1)+1 by ring, Nat.factorial_succ]; ring]
      push_cast
      rfl
    have hpow : (x:ℝ)^(2*k+3) = x^(2*k+1) * x^2 := by
      rw [show (2*k+3:ℕ) = (2*k+1)+2 by ring, pow_add]
    have hpos' : 0 ≤ x^(2*k+1) * ((2*k+1)! : ℝ) :=
      mul_nonneg (pow_nonneg hx _) (Nat.cast_nonneg _)
    rw [hpow, hfact, div_le_div_iff₀ (by positivity) (by positivity)]
    have h1 := mul_le_mul_of_nonneg_right (hmono k) hpos'
    nlinarith [hmono k, h1]
  have hpos : ∀ k, 0 ≤ x^(2*k+1)/((2*k+1)! : ℝ) :=
    fun k => div_nonneg (pow_nonneg hx _) (Nat.cast_nonneg _)
  have hss : Summable (fun k => (-1:ℝ)^k * (x^(2*k+1)/((2*k+1)! : ℝ))) :=
    Summable.congr (Real.hasSum_sin x).summable (fun k => mul_div_assoc _ _ _)
  have h1 := alternating_tail (fun k => x^(2*k+1)/((2*k+1)! : ℝ)) (n+1) (fun k _ => hdec k) hpos hss
  have h2 : (∑' k : ℕ, (-1:ℝ)^k * (x^(2*k+1)/((2*k+1)! : ℝ))) = sin x := by
    have h3 : HasSum (fun k : ℕ => (-1:ℝ)^k * (x^(2*k+1)/((2*k+1)! : ℝ))) (sin x) := by
      simpa only [mul_div_assoc] using Real.hasSum_sin x
    exact h3.tsum_eq
  rw [h2] at h1
  rw [show (2*(n+1)+1:ℕ) = 2*n+3 by ring] at h1
  simp only [← mul_div_assoc] at h1
  exact h1

/-- `cos x` is within `x^(2n+2)/(2n+2)!` of the range-`(n+1)` alternating
partial sum of its power series (terms decrease once `x^2 ≤ 2`). -/
theorem cos_partial_abs_bound (x : ℝ) (hx : 0 ≤ x) (n : ℕ)
    (hmono : ∀ k : ℕ, x^2 ≤ (2*k+1)*(2*k+2)) :
    |cos x - (∑ k ∈ Finset.range (n+1), (-1:ℝ)^k * x^(2*k)/((2*k)! : ℝ))|
      ≤ x^(2*n+2)/((2*n+2)! : ℝ) := by
  have hdec : ∀ k, x^(2*(k+1))/((2*(k+1))! : ℝ) ≤ x^(2*k)/((2*k)! : ℝ) := by
    intro k
    have hk : (2*(k+1) : ℕ) = 2*k+2 := by ring
    rw [hk]
    have hfact : ((2*k+2)! : ℝ) = ((2*k+2) * (2*k+1)! : ℝ) := by
      rw [show ((2*k+2)! : ℕ) = (2*k+2) * (2*k+1)! by
        rw [show (2*k+2:ℕ) = (2*k+1)+1 by ring, Nat.factorial_succ]]
      push_cast
      rfl
    have hpow : (x:ℝ)^(2*k+2) = x^(2*k) * x^2 := by
      rw [pow_add]
    have hEq : ((2*k+1)! : ℝ) = ((2*k+1) * (2*k)! : ℝ) := by
      rw [show ((2*k+1)! : ℕ) = (2*k+1) * (2*k)! by
        rw [show (2*k+1:ℕ) = (2*k)+1 by ring, Nat.factorial_succ]]
      push_cast
      rfl
    rw [hpow, hfact, div_le_div_iff₀ (by positivity) (by positivity)]
    have h2' := mul_le_mul_of_nonneg_right (hmono k) (by positivity : 0 ≤ ((2*k)! : ℝ))
    -- h2' : x^2 * ↑((2*k)!) ≤ (2*k+1)*(2*k+2) * ↑((2*k)!)
    calc (x:ℝ)^(2*k) * x^2 * ((2*k)! : ℝ)
        = x^2 * ((2*k)! : ℝ) * x^(2*k) := by ring
      _ ≤ ((2*k+1)*(2*k+2) : ℝ) * ((2*k)! : ℝ) * x^(2*k) :=
          mul_le_mul_of_nonneg_right h2' (pow_nonneg hx (2*k))
      _ = (x:ℝ)^(2*k) * ((2*k+2) * ((2*k+1)! : ℝ)) := by
          rw [hEq]; ring
  have hpos : ∀ k, 0 ≤ x^(2*k)/((2*k)! : ℝ) :=
    fun k => div_nonneg (pow_nonneg hx _) (Nat.cast_nonneg _)
  have hss : Summable (fun k => (-1:ℝ)^k * (x^(2*k)/((2*k)! : ℝ))) :=
    Summable.congr (Real.hasSum_cos x).summable (fun k => mul_div_assoc _ _ _)
  have h1 := alternating_tail (fun k => x^(2*k)/((2*k)! : ℝ)) (n+1) (fun k _ => hdec k) hpos hss
  have h2 : (∑' k : ℕ, (-1:ℝ)^k * (x^(2*k)/((2*k)! : ℝ))) = cos x := by
    have h3 : HasSum (fun k : ℕ => (-1:ℝ)^k * (x^(2*k)/((2*k)! : ℝ))) (cos x) := by
      simpa only [mul_div_assoc] using Real.hasSum_cos x
    exact h3.tsum_eq
  rw [h2] at h1
  rw [show (2*(n+1):ℕ) = 2*n+2 by ring] at h1
  simp only [← mul_div_assoc] at h1
  exact h1

/-! ## The generic sinc bracket (consumer contract, exact statement) -/

/-- Consumer contract per argument interval [tl,th]: j = reduction index,
[s0,s1] = reduced window, [P,Q] = certified series bound for sin(πu) on the
window (from partial sums + `alternating_tail`), [lo,hi] = final sinc bracket.
The first hypothesis is the window-partition fact; the last two are the
instantiated ℚ-data facts. -/
theorem sinc_bracket (tl th : ℝ) (j : ℤ) (s0 s1 P Q lo hi : ℝ)
    (htl0 : 0 < tl)
    (hmem : ∀ t, tl ≤ t → t ≤ th → s0 ≤ (t - j*π)/π ∧ (t - j*π)/π ≤ s1)
    (hsinj : ∀ t, tl ≤ t → t ≤ th → sin t = (-1 : ℝ)^j * sin (π*((t - j*π)/π)))
    (hser : ∀ u, s0 ≤ u → u ≤ s1 → P ≤ sin (π*u) ∧ sin (π*u) ≤ Q)
    (hdiv : ∀ t, tl ≤ t → t ≤ th →
        lo ≤ ((-1 : ℝ)^j * sin (π*((t - j*π)/π))) / t ∧
        ((-1 : ℝ)^j * sin (π*((t - j*π)/π))) / t ≤ hi) :
    ∀ t, tl ≤ t → t ≤ th → lo ≤ sinc t ∧ sinc t ≤ hi := by
  intro t htl hth
  have hne : t ≠ 0 := by
    intro h
    subst h
    linarith
  simp only [sinc, if_neg hne]
  have h1 := hsinj t htl hth
  have h2 := hdiv t htl hth
  rw [h1]
  exact h2

end CLZ
